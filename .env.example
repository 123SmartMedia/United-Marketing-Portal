# Copy to .env.local and fill in for form email delivery.
# Without SENDGRID_API_KEY the site still runs; submissions are logged to the
# server console instead of emailed (useful for local dev / staging).

# SendGrid API key — https://sendgrid.com (Mail Send permission is enough)
SENDGRID_API_KEY=

# Where request-form submissions are delivered.
REQUEST_EMAIL=marketing@unitedmortgage.com

# Sender address. Must be a verified sender / authenticated domain in SendGrid.
# To send AS marketing@unitedmortgage.com, that address must be a verified
# Single Sender, or unitedmortgage.com must be domain-authenticated in SendGrid.
FROM_EMAIL="United Marketing Desk <marketing@unitedmortgage.com>"

# --- Assets (Cloudflare R2) ---
# Runtime base URL for assets. Set in Vercel env to the R2 public bucket URL
# (e.g. https://pub-xxxx.r2.dev). Leave unset locally to use the public/assets
# junction. Must be NEXT_PUBLIC_ so client components can inline it.
NEXT_PUBLIC_ASSET_BASE_URL=

# Credentials for scripts/upload-to-r2.mjs (npm run upload-assets). These are
# only needed to push the asset library to R2 — not needed at runtime.
R2_ACCOUNT_ID=fb6c96add9dfcefd5f3722a2020122fc
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=united-marketing-assets

# Separate PRIVATE bucket for request-form attachments. These files are staged
# between the browser and Jira and must never be publicly readable, so this
# bucket must have NO public r2.dev domain and NO custom domain.
#
# It MUST be a different bucket from R2_BUCKET above. R2_BUCKET serves the public
# asset catalog and must never accept browser uploads. If R2_UPLOADS_BUCKET is
# unset the app falls back to R2_BUCKET and logs a loud warning; the CORS script
# refuses to run at all in that case.
#
# Objects live under the prefix `marketing-requests/` and are deleted by the app
# as soon as Jira has the file. Apply the backstop expiry rule once with:
#   node --env-file=.env.local scripts/set-r2-lifecycle.mjs
# and the browser-PUT CORS rule once with:
#   node --env-file=.env.local scripts/set-r2-cors.mjs
R2_UPLOADS_BUCKET=united-marketing-request-uploads

# --- Admin content CMS (/admin) ---
# Shared password the social media manager uses to sign in and add pieces.
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie (any long random string).
# Falls back to ADMIN_PASSWORD if unset, but a separate value is better.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Jira Service Management — /custom-requests submissions
# ---------------------------------------------------------------------------
# The custom-request wizard posts to /api/jira/requests, which creates the
# ticket server-side. NEVER expose these to the browser: no NEXT_PUBLIC_ prefix,
# and never import src/lib/jira/* from a client component.
#
# Run `npm run jira:discover` to find the verified IDs — do not guess them.
# Full setup guide: docs/jira-integration.md

# Human-facing Atlassian site. Used for portal links, and to validate the link
# Jira returns for a created request. NOT necessarily the API host — see below.
JIRA_SITE_URL=https://unitedmortgage.atlassian.net

# --- Authentication mode (REQUIRED, never guessed) ---
#   scoped_token  An Atlassian organization SERVICE ACCOUNT with a SCOPED API
#                 token. Scoped tokens only work through the Platform API
#                 Gateway, so calls go to
#                     https://api.atlassian.com/ex/jira/${JIRA_CLOUD_ID}
#                 and the token is sent as `Authorization: Bearer <token>`.
#                 Requires JIRA_CLOUD_ID. No email is used.
#
#   site_basic    Legacy: a classic UNSCOPED API token belonging to an Atlassian
#                 account, sent as HTTP Basic email:token directly to
#                 JIRA_SITE_URL. Requires JIRA_SERVICE_ACCOUNT_EMAIL.
#
# Leaving this unset (or setting anything else) leaves the integration
# unconfigured — the form returns a clean "not available" message.
JIRA_AUTH_MODE=scoped_token

# Your Atlassian cloud id (scoped_token mode only). Find it at
# https://unitedmortgage.atlassian.net/_edge/tenant_info
# VERIFIED via read-only Atlassian MCP, 2026-09-21. Not a secret: it is an
# instance identifier, not a credential.
JIRA_CLOUD_ID=638ffe69-6618-4145-b60c-144cfb581ff6

# The API token itself. Scoped token for scoped_token mode; classic API token
# for site_basic. Create at:
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Only needed for site_basic mode — the account the token belongs to.
# (JIRA_API_EMAIL is accepted as a legacy alias.)
JIRA_SERVICE_ACCOUNT_EMAIL=

# --- Service desk / request type ---
# Normally the 68 in the portal URL is the PORTAL id and is NOT the serviceDeskId.
# On THIS instance they happen to be the same value: read-only Atlassian MCP
# (2026-09-21) read serviceDeskId "68" and portalId "68" off the Request Type field
# of existing MKT issues. Project: Marketing Requests, key MKT, project id 10100.
JIRA_SERVICE_DESK_ID=68

# NOT VERIFIED. The Atlassian MCP catalog has no /rest/servicedeskapi/ operations,
# so the portal's request type list could not be read. Only three request types were
# observable (from existing issues), and none matches the UMC form:
#   114 Ask a question            -> issue type 10079
#   115 MKT – Emailed Request     -> issue type 10080  (email intake ONLY - do not use)
#   116 Social Media Post / Graphic -> issue type 10078, portal group 81
# The group id on 116 proves more request types exist. The target MUST be a request
# type whose issueTypeId is 10078 — that is the only issue type carrying the MKT
# custom fields. Resolve with `npm run jira:discover` and do NOT guess.
JIRA_REQUEST_TYPE_ID=

# Customer-facing portal link shown on /custom-requests and in the success state.
JIRA_PORTAL_URL=https://unitedmortgage.atlassian.net/servicedesk/customer/portal/68

# --- Reporter identity ---
# service_account (default): the integration account is the Jira reporter and the
#   submitter's name/email are carried in Jira fields + the description.
# on_behalf_of: raise the request as the submitter via raiseOnBehalfOf. The site
#   is NOT authenticated, so this only applies to addresses in the allow-list
#   below AND only when a matching Jira customer already exists. No Jira customer
#   account is ever created or invited automatically.
JIRA_REPORTER_MODE=service_account
JIRA_ALLOWED_REPORTER_DOMAINS=unitedmortgage.com

# --- Behavior toggles ---
# Attach request files to the Jira ticket (requires the R2 upload vars above).
JIRA_ATTACHMENTS_ENABLED=true
# Keep sending the courtesy acknowledgment email to the submitter.
JIRA_ACK_EMAIL=true
# DISCLOSED FALLBACK, off by default: when true, a Jira failure falls back to the
# old SendGrid email delivery instead of failing the submission.
JIRA_EMAIL_FALLBACK=false
# Per-call Jira timeout in milliseconds.
JIRA_TIMEOUT_MS=15000

# --- Field mapping (all optional) ---
# Map UMC form fields onto verified Jira custom field IDs. Any field left unset
# is still delivered inside the Jira description — nothing submitted is dropped.
#
# The IDs below are the REAL Marketing Requests (MKT) fields, read through the
# read-only Atlassian MCP connector on 2026-09-21 from
#   getJiraIssueTypeMetaWithFields(MKT, issueTypeId=10078, requiredFieldsOnly=false)
# Full inventory, option IDs and the mapping decisions: docs/jira-mcp-discovery.md
#
# The earlier placeholders in this file (customfield_10050..10069) were invented and
# have been removed — on this instance customfield_10060 is the "Time to resolution"
# SLA field, so copying them would have written to the wrong fields.
#
# CAVEAT for every line below: a field existing on issue type 10078 does not mean the
# REQUEST TYPE exposes it on the portal. Request-type field config is a
# /rest/servicedeskapi/ read that MCP cannot perform. Confirm with
# `npm run jira:discover -- --service-desk 68 --request-type <id>` before enabling.

# VERIFIED and semantically exact: MKT – Requested Due Date (date).
JIRA_FIELD_DATE_NEEDED=customfield_10301

# VERIFIED field IDs, but NOT safe to enable without a decision — see
# docs/jira-mcp-discovery.md §3:
#
#   customfield_10297  MKT – Branch / Team            single-select; its context
#                      returned only option 10152 "Other / Not Listed", while UMC
#                      collects `branch` as free text. Resolve the option set first.
# JIRA_FIELD_BRANCH=customfield_10297
#
#   customfield_10303  MKT – Compliance Review Needed  Yes=10165 / No=10166.
#                      SEMANTICS ARE INVERTED: UMC's `complianceApproved` means
#                      "compliance already approved this", Jira means "this needs
#                      compliance review". Mapping true->Yes would route approved
#                      work into the review queue.
# JIRA_FIELD_COMPLIANCE_APPROVED=customfield_10303

# NO STRUCTURED TARGET EXISTS on this instance for these UMC fields. They are
# delivered in the Jira description, which is by design and loses nothing:
#   requestType, rush, name, email, phone, nmls, printingNeeded, quantity, size,
#   finish, cobrand, partnerName, projectTitle, keyMessage, additionalDetails,
#   asset, details
# To structure any of them, a Jira admin must create the field first, then add the
# matching JIRA_FIELD_* line here.

# Other verified MKT fields on issue type 10078 that the UMC form does NOT collect.
# Listed so the gap is visible; none is required at the Jira issue level.
#   customfield_10298  MKT – Requester Role      10153 Loan Officer / 10154 Branch Manager
#                                                10155 Sales Manager / 10156 Executive / 10157 Other
#   customfield_10299  MKT – Urgency             10158 Critical / 10159 High / 10160 Medium / 10161 Low
#   customfield_10300  MKT – Impact              10162 Company-wide / 10163 Branch / 10164 Individual
#   customfield_10302  MKT – Rush Justification  free text
#   customfield_10304  MKT – Deliverable Format  multi-select: 10167 PNG / 10168 PDF /
#                                                10169 Print / 10170 Video / 10171 HTML / 10172 Other
# Not on the create screen (automation-populated — do not send at creation):
#   customfield_10305  MKT – Intake Channel      10173 Portal / 10175 Email
#   customfield_10306/10307/10308  Work Started / Delivered / Revision Count

# Option IDs for select fields, as reported by `npm run jira:discover`. Without
# an entry the option label is sent by value, which Jira resolves by name.
# No entry is set yet: the one enabled mapping (dateNeeded) is a date field and has
# no options, and every verified option field above is still a pending decision.
# JIRA_FIELD_OPTIONS={"branch":{"Other / Not Listed":"10152"}}

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — bot protection for /custom-requests
# ---------------------------------------------------------------------------
# /custom-requests is public and unauthenticated. The widget token is redeemed
# SERVER-SIDE on every submission, before any Jira or attachment work.
#
# Without TURNSTILE_SECRET_KEY the check is SKIPPED and every submission logs a
# warning — that keeps local development usable, but production MUST set it.
# Keys: https://dash.cloudflare.com → Turnstile → Add site

# The widget's site key. PUBLIC by design — it identifies the widget and is
# visible in the page source.
#
# Deliberately NOT prefixed with NEXT_PUBLIC_. Next.js replaces every
# `process.env.NEXT_PUBLIC_*` reference with a literal during `next build`, in
# server code as well as client code, so the value is frozen into the bundle and
# only a rebuild can change it. Without the prefix it stays a real runtime lookup,
# and /custom-requests (a dynamic Server Component) reads it on every request —
# so rotating this key takes effect immediately, with no rebuild and no redeploy.
TURNSTILE_SITE_KEY=

# DEPRECATED — replaced by TURNSTILE_SITE_KEY above, and no longer read by any
# code. It was build-frozen, which is how production ended up serving an empty
# site key after the key had been added in Vercel. Delete it from Vercel once
# TURNSTILE_SITE_KEY is set.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# SECRET. Server-side only, never sent to the browser, never a component prop.
# Read exclusively by src/lib/turnstile.js when redeeming a token against
# Cloudflare siteverify. Never prefix this with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=

# The hostname the challenge must have been solved on. Rejects a token minted on
# an attacker's copy of the form. Use localhost for local testing.
TURNSTILE_EXPECTED_HOSTNAME=marketing.unitedmortgage.com

# The action name the widget declares and the server requires. A token minted for
# a different action on the same site key is rejected.
# (TURNSTILE_ACTION is accepted as a legacy alias.)
TURNSTILE_EXPECTED_ACTION=marketing_request

# Optional siteverify timeout in milliseconds (default 10000).
# TURNSTILE_TIMEOUT_MS=10000

# --- Local development and CI ---
# Cloudflare publishes test keys so no real key is ever needed off production.
# They are NOT secrets. Uncomment the pair you want:
#   always passes
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#   always fails (use to exercise the rejection path)
# TURNSTILE_SITE_KEY=2x00000000000000000000AB
# TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AA
# With the test keys, set TURNSTILE_EXPECTED_HOSTNAME=localhost.

# ---------------------------------------------------------------------------
# Secure two-stage upload (/api/jira/requests/init -> .../finalize)
# ---------------------------------------------------------------------------
# HMAC key that signs the short-lived finalize token. The token binds the request
# id, the idempotency key, the permitted R2 object keys, a hash of the form
# payload and an expiry — so a caller cannot swap files, edit the form, or reuse
# another submission's upload slots between the two stages.
#
# SECRET. Server-side only, never prefixed with NEXT_PUBLIC_. Minimum 32
# characters; a shorter value leaves the flow unconfigured rather than signing
# with something guessable.
#
# Generate one (do NOT reuse this example, and never commit a real value):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
UPLOAD_FINALIZE_SECRET=

# ---------------------------------------------------------------------------
# Submitter allow-list
# ---------------------------------------------------------------------------
# Server-side gate on who may submit a marketing request. The HTML email field
# proves nothing on a public page; this is the check that actually holds.
# Comma-separated. Leave EMPTY for local dev to accept any domain.
ALLOWED_REQUEST_EMAIL_DOMAINS=unitedmortgage.com
